---
import { getMenu, getEmDashCollection, getSiteSettings } from "emdash";
import {
	WidgetArea,
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import Logo from "../components/Logo.astro";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;
const settings = await getSiteSettings();
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);
const faviconUrl = settings.favicon?.url ?? null;
// If title already includes site title (from getSeoMeta), use as-is
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;

// Fetch primary menu defined in seed
const menu = await getMenu("primary");

// Core navigation stays in the header; legal/support links move to the footer
const LEGAL_SUFFIXES = [
	"/pages/official-references-profiles",
	"/pages/privacy-policy",
	"/pages/terms-of-use",
];
const menuItems = menu?.items ?? [];
const navItems = menuItems.filter((item) =>
	LEGAL_SUFFIXES.every((suffix) => item.url !== suffix)
);
const legalItems = menuItems.filter((item) =>
	LEGAL_SUFFIXES.some((suffix) => item.url === suffix)
);
// Compare nav URLs ignoring a trailing slash on the current path
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const isActive = (url: string) => url.replace(/\/$/, "") === currentPath;

// Build public page context for plugin contributions
// SEO data is passed here and rendered securely by EmDashHead
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

// Check if user is logged in (for showing admin link)
const isLoggedIn = !!Astro.locals.user;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-display" preload />
		<Font cssVariable="--font-hero" preload />
		<Font cssVariable="--font-section" />
		<Font cssVariable="--font-mono" />
		<title>{fullTitle}</title>
		{
			faviconUrl && (
				<link rel="icon" type="image/png" href={faviconUrl} />
			)
		}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<EmDashHead page={pageCtx} />
		<script is:inline>
			// Apply an explicit theme choice immediately to prevent flash.
			// With no cookie, color-scheme: light dark follows the OS.
			(function () {
				var c = document.cookie;
				var i = c.indexOf("theme=");
				var theme = i >= 0 ? c.slice(i + 6).split(";")[0] : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				}
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
	<header class="site-header">
		<nav class="nav" aria-label="Primary">
			<a href="/" class="brand" aria-label="99Ways — home">
				<img
					class="brand-frog"
					src="/_emdash/api/media/file/01M2JA3P4EGPSMNYQYM41QKSVA.webp"
					alt="99Ways frog mascot"
					width="44"
					height="44"
					fetchpriority="high"
				/>
				<Logo />
			</a>
			<div class="nav-right">
				<button
					type="button"
					class="nav-toggle"
					aria-expanded="false"
					aria-controls="site-nav-links"
					aria-label="Menu"
				>
					<span class="nav-toggle-bar"></span>
					<span class="nav-toggle-bar"></span>
					<span class="nav-toggle-bar"></span>
				</button>
				<div class="nav-links" id="site-nav-links">
					<div class="nav-drop">
						<button
							type="button"
							class:list={[
								"nav-top",
								(isActive("/category/guides-how-to") ||
									isActive("/category/posthog-feature-breakdown") ||
									isActive("/category/tools-comparison") ||
									isActive("/category/optimization-experience") ||
									isActive("/category/featured-experiments")) &&
									"active-parent",
							]}
							aria-haspopup="true"
							aria-expanded="false"
						>
							Resources
							<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
						</button>
						<div class="nav-menu" aria-label="Resources">
							<p class="nav-menu-kicker">Learn</p>
							<a href="/category/guides-how-to" class={isActive("/category/guides-how-to") ? "active" : ""}>Guides and How-tos <span class="nav-arrow" aria-hidden="true">→</span></a>
							<a href="/category/posthog-feature-breakdown" class={isActive("/category/posthog-feature-breakdown") ? "active" : ""}>PostHog Feature Breakdowns <span class="nav-arrow" aria-hidden="true">→</span></a>
							<a href="/category/tools-comparison" class={isActive("/category/tools-comparison") ? "active" : ""}>Tools Comparison <span class="nav-arrow" aria-hidden="true">→</span></a>
							<a href="/category/optimization-experience" class={isActive("/category/optimization-experience") ? "active" : ""}>Optimization Experiences <span class="nav-arrow" aria-hidden="true">→</span></a>
							<a href="/category/featured-experiments" class={isActive("/category/featured-experiments") ? "active" : ""}>Featured Experiments <span class="nav-arrow" aria-hidden="true">→</span></a>
						</div>
					</div>
					<div class="nav-drop">
						<button
							type="button"
							class:list={[
								"nav-top",
								(isActive("/pages/hire-cro-expert") ||
									isActive("/posts/hire-posthog-expert-guide") ||
									isActive("/posts/hire-hyros-expert-guide")) &&
									"active-parent",
							]}
							aria-haspopup="true"
							aria-expanded="false"
						>
							Services
							<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
						</button>
						<div class="nav-menu" aria-label="Services">
							<p class="nav-menu-kicker">Work with us</p>
							<a href="/pages/hire-cro-expert" class={isActive("/pages/hire-cro-expert") ? "active" : ""}>Conversion Rate Optimization <span class="nav-arrow" aria-hidden="true">→</span></a>
							<a href="/posts/hire-posthog-expert-guide" class={isActive("/posts/hire-posthog-expert-guide") ? "active" : ""}>PostHog &amp; Product Analytics <span class="nav-arrow" aria-hidden="true">→</span></a>
							<a href="/posts/hire-hyros-expert-guide" class={isActive("/posts/hire-hyros-expert-guide") ? "active" : ""}>Hyros &amp; Tracking Setup <span class="nav-arrow" aria-hidden="true">→</span></a>
						</div>
					</div>
					<a
						href="/pages/contact-form"
						class:list={["nav-contact", isActive("/pages/contact-form") && "active"]}
					>
						Contact Us
					</a>
				</div>
				{
						isLoggedIn && (
							<a href="/_emdash/admin" class="nav-admin">
								Admin
							</a>
						)
					}
			</div>
		</nav>
	</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-inner">
				<div class="footer-grid">
					<div class="footer-brand">
						<a href="/" class="footer-logo" aria-label="99Ways — home">
							<Logo size="lg" />
						</a>
						<p class="footer-tagline">{siteTagline}</p>
						<p class="footer-description">
							99Ways writes about conversion rate optimization,
							experimentation, analytics, and tracking.
						</p>
					</div>
					<div class="footer-col">
						<h4 class="footer-heading">Navigate</h4>
						<ul class="footer-links">
							{
								navItems.map((item) => (
									<li>
										<a href={item.url} target={item.target}>{item.label}</a>
									</li>
								))
							}
							<li><a href="/rss.xml">RSS feed</a></li>
						</ul>
					</div>
					<div class="footer-col">
						<h4 class="footer-heading">Topics</h4>
						<ul class="footer-links">
							<li><a href="/category/guides-how-to">Guides &amp; How-tos</a></li>
							<li><a href="/category/optimization-experience">Optimization Experiences</a></li>
							<li><a href="/category/posthog-feature-breakdown">PostHog Feature Breakdowns</a></li>
						</ul>
					</div>
					<div class="footer-col">
						<h4 class="footer-heading">Company</h4>
						<ul class="footer-links">
							{
								legalItems.map((item) => (
									<li>
										<a href={item.url} target={item.target}>{item.label}</a>
									</li>
								))
							}
						</ul>
					</div>
				</div>
				<div class="footer-bottom">
					<p class="footer-copyright">
						© {new Date().getFullYear()} {siteTitle}. All rights reserved.
					</p>
					<div class="theme-switcher">
						<button
							type="button"
							class="theme-btn"
							data-theme="light"
							aria-label="Light mode"
						>
							<svg
								width="16"
								height="16"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								><circle cx="12" cy="12" r="5"></circle><line
									x1="12"
									y1="1"
									x2="12"
									y2="3"></line><line x1="12" y1="21" x2="12" y2="23"
								></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"
								></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"
								></line><line x1="1" y1="12" x2="3" y2="12"></line><line
									x1="21"
									y1="12"
									x2="23"
									y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"
								></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"
								></line></svg
							>
						</button>
						<button
							type="button"
							class="theme-btn"
							data-theme="dark"
							aria-label="Dark mode"
						>
							<svg
								width="16"
								height="16"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
								></path></svg
							>
						</button>
						<button
							type="button"
							class="theme-btn"
							data-theme="system"
							aria-label="System theme"
						>
							<svg
								width="16"
								height="16"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								><rect x="2" y="3" width="20" height="14" rx="2" ry="2"
								></rect><line x1="8" y1="21" x2="16" y2="21"></line><line
									x1="12"
									y1="17"
									x2="12"
									y2="21"></line></svg
							>
						</button>
					</div>
				</div>
			</div>
		</footer>

		<script>
			// Theme switcher
			const THEME_REGEX = /theme=([^;]+)/;
			const themeBtns =
				document.querySelectorAll<HTMLButtonElement>(".theme-btn");
			const root = document.documentElement;

			function setCookie(
				name: string,
				value: string,
				maxAge: number = 31536000
			) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				if (value === "") {
					document.cookie = `${name}=; path=/; max-age=0; SameSite=Lax${secure}`;
				} else {
					document.cookie = `${name}=${value}; path=/; max-age=${maxAge}; SameSite=Lax${secure}`;
				}
			}

			function setTheme(theme: string) {
				if (theme === "system") {
					setCookie("theme", "");
					root.classList.remove("light", "dark");
				} else {
					setCookie("theme", theme);
					root.classList.remove("light", "dark");
					root.classList.add(theme);
				}
				updateActiveBtn(theme);
			}

			function updateActiveBtn(theme: string) {
				themeBtns.forEach((btn) => {
					btn.classList.toggle("active", btn.dataset.theme === theme);
				});
			}

			function getStoredTheme(): string {
				const match = document.cookie.match(THEME_REGEX);
				return match ? match[1] : "system";
			}

			// Initialize
			const storedTheme = getStoredTheme();
			setTheme(storedTheme);

			themeBtns.forEach((btn) => {
				btn.addEventListener("click", () => {
					setTheme(btn.dataset.theme || "system");
				});
			});
		</script>

		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			@layer base {
				*:where(:not([class*="emdash"]):not([class*="ec-"])),
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::before,
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::after {
					box-sizing: border-box;
				}

				body,
				h1,
				h2,
				h3,
				h4,
				h5,
				h6,
				p,
				ul,
				ol,
				figure,
				blockquote,
				dl,
				dd {
					margin: 0;
				}

				ul,
				ol {
					padding: 0;
				}

				/*
				 * Design tokens live in src/styles/tokens.css. Colors are
				 * defined with light-dark(); these rules pin the scheme when
				 * the footer switcher sets an explicit choice. With no class,
				 * color-scheme: light dark follows the OS preference.
				 */
				@supports (color: light-dark(#000, #fff)) {
					:root.light {
						color-scheme: light;
					}

					:root.dark {
						color-scheme: dark;
					}
				}

				html {
					scroll-behavior: smooth;
				}

				body {
					font-family: var(--font-body);
					font-size: var(--font-size-base);
					line-height: var(--leading-relaxed);
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					-moz-osx-font-smoothing: grayscale;
					min-height: 100vh;
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])) {
					color: var(--color-brand);
					text-decoration: none;
					transition: color var(--transition-fast);
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])):hover {
					color: var(--color-brand-hover);
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4,
				h5,
				h6 {
					font-family: var(--font-heading);
					line-height: var(--leading-tight);
					font-weight: var(--font-weight-heading);
					letter-spacing: var(--tracking-snug);
				}

				h1 {
					font-weight: var(--font-weight-display);
					letter-spacing: var(--tracking-tight);
				}

				::selection {
					background: var(--color-brand);
					color: var(--color-on-brand);
				}
			}
		</style>

		<style>
		.site-header {
			position: sticky;
			top: 0;
			z-index: 100;
			background: color-mix(in srgb, var(--color-bg) 88%, transparent);
			backdrop-filter: blur(14px);
			-webkit-backdrop-filter: blur(14px);
			border-top: 3px solid var(--color-logo);
			border-bottom: 1px solid var(--color-border-subtle);
			box-shadow: 0 8px 24px -18px color-mix(in srgb, var(--color-text) 35%, transparent);
		}

		.nav {
			display: flex;
			justify-content: space-between;
			align-items: center;
			gap: var(--spacing-4);
			max-width: var(--wide-width);
			margin: 0 auto;
			padding: var(--spacing-3) var(--page-gutter);
			min-height: var(--nav-height);
		}

		.brand {
			display: inline-flex;
			align-items: center;
			gap: var(--spacing-3);
			color: var(--color-text);
			text-decoration: none;
			min-width: 0;
		}

		.brand-frog {
			width: 44px;
			height: 44px;
			border-radius: 50%;
			object-fit: cover;
			display: block;
			background: var(--color-surface);
			border: 1px solid var(--color-border);
			box-shadow: var(--shadow-sm);
		}

		.brand:hover .brand-frog {
			animation: frog-hop 0.55s ease;
		}

		@keyframes frog-hop {
			0% { transform: translateY(0) rotate(0deg); }
			35% { transform: translateY(-7px) rotate(-6deg); }
			70% { transform: translateY(0) rotate(4deg); }
			100% { transform: translateY(0) rotate(0deg); }
		}

		@media (prefers-reduced-motion: reduce) {
			.brand:hover .brand-frog {
				animation: none;
			}
		}

		.nav-right {
			display: flex;
			align-items: center;
			gap: var(--spacing-5);
			margin-inline-start: auto;
		}

		.nav-toggle {
			display: none;
			flex-direction: column;
			justify-content: center;
			gap: 5px;
			width: 40px;
			height: 40px;
			padding: 0 10px;
			background: transparent;
			border: 1px solid var(--color-border);
			border-radius: var(--radius);
			cursor: pointer;
		}

		.nav-toggle-bar {
			display: block;
			height: 2px;
			width: 100%;
			background: var(--color-text);
			border-radius: 2px;
			transition: transform var(--transition-fast), opacity var(--transition-fast);
		}

		.nav-links {
			display: flex;
			align-items: center;
			gap: var(--spacing-2);
			font-size: var(--font-size-sm);
		}

		.nav-drop {
			position: relative;
		}

		.nav-top {
			display: inline-flex;
			align-items: center;
			gap: 0.375rem;
			padding: var(--spacing-2) var(--spacing-3);
			background: transparent;
			border: none;
			border-radius: var(--radius);
			cursor: pointer;
			color: var(--color-muted);
			font-family: var(--font-mono);
			font-size: var(--font-size-kicker);
			font-weight: 600;
			line-height: 1;
			letter-spacing: var(--tracking-eyebrow);
			text-transform: uppercase;
			transition: color var(--transition-fast), background var(--transition-fast);
		}

		.nav-top:hover,
		.nav-drop:hover .nav-top,
		.nav-drop:focus-within .nav-top,
		.nav-drop.open .nav-top,
		.nav-top.active-parent {
			color: var(--color-text);
			background: var(--color-surface);
		}

		.nav-top svg {
			transition: transform var(--transition-fast);
		}

		.nav-drop:hover .nav-top svg,
		.nav-drop:focus-within .nav-top svg,
		.nav-drop.open .nav-top svg {
			transform: rotate(180deg);
		}

		.nav-menu {
			position: absolute;
			top: calc(100% + 10px);
			left: 0;
			min-width: 320px;
			padding: var(--spacing-3);
			padding-top: calc(var(--spacing-3) + 3px);
			background: var(--color-bg);
			border: 1px solid var(--color-border);
			border-radius: var(--radius-lg);
			box-shadow: var(--shadow-lg);
			overflow: hidden;
			opacity: 0;
			visibility: hidden;
			transform: translateY(8px);
			transition: opacity var(--transition-fast), transform var(--transition-fast), visibility var(--transition-fast);
			z-index: 200;
		}

		.nav-menu::before {
			content: "";
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			height: 3px;
			background: linear-gradient(90deg, var(--color-success), var(--color-brand));
		}

		.nav-drop:hover .nav-menu,
		.nav-drop:focus-within .nav-menu,
		.nav-drop.open .nav-menu {
			opacity: 1;
			visibility: visible;
			transform: translateY(0);
		}

		.nav-menu-kicker {
			padding: var(--spacing-2) var(--spacing-3) var(--spacing-1);
			font-family: var(--font-mono);
			font-size: var(--font-size-xs);
			font-weight: 600;
			letter-spacing: var(--tracking-eyebrow);
			text-transform: uppercase;
			color: var(--color-muted);
		}

		.nav-menu a {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: var(--spacing-3);
			padding: var(--spacing-3);
			border-radius: var(--radius);
			color: var(--color-text-secondary);
			text-decoration: none;
			font-size: var(--font-size-sm);
			font-weight: 500;
			transition: background var(--transition-fast), color var(--transition-fast);
		}

		.nav-menu a:hover,
		.nav-menu a.active {
			background: var(--color-surface);
			color: var(--color-text);
		}

		.nav-menu a .nav-arrow {
			opacity: 0;
			transform: translateX(-4px);
			transition: opacity var(--transition-fast), transform var(--transition-fast);
			color: var(--color-success);
		}

		.nav-menu a:hover .nav-arrow,
		.nav-menu a.active .nav-arrow {
			opacity: 1;
			transform: translateX(0);
		}

		.nav-contact {
			display: inline-flex;
			align-items: center;
			margin-inline-start: var(--spacing-2);
			padding: 0.625rem 1.375rem;
			border-radius: 999px;
			background: var(--color-text);
			color: var(--color-bg);
			font-family: var(--font-mono);
			font-size: var(--font-size-kicker);
			font-weight: 700;
			line-height: 1;
			letter-spacing: var(--tracking-eyebrow);
			text-transform: uppercase;
			text-decoration: none;
			border: 1px solid transparent;
			box-shadow: var(--shadow-sm);
			transition: background var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
		}

		.nav-contact:hover {
			background: var(--color-success);
			color: #fff;
			transform: translateY(-1px);
			box-shadow: var(--shadow-lg);
		}

		.nav-contact.active {
			outline: 2px solid var(--color-success);
			outline-offset: 2px;
		}

		.nav-admin {
			font-size: var(--font-size-sm);
			color: var(--color-text-secondary);
			text-decoration: none;
			transition: color var(--transition-fast);
		}

		.nav-admin:hover {
			color: var(--color-text);
		}

		@media (max-width: 760px) {
			.nav-toggle {
				display: inline-flex;
			}

			.nav-links {
				display: none;
				position: absolute;
				top: 100%;
				left: 0;
				right: 0;
				flex-direction: column;
				align-items: stretch;
				gap: var(--spacing-2);
				padding: var(--spacing-4) var(--page-gutter) var(--spacing-6);
				background: var(--color-bg);
				border-bottom: 1px solid var(--color-border);
				box-shadow: var(--shadow-lg);
			}

			.nav-links.open {
				display: flex;
			}

			.nav-drop {
				width: 100%;
			}

			.nav-top {
				width: 100%;
				justify-content: space-between;
				padding: var(--spacing-3);
			}

			.nav-menu {
				position: static;
				display: none;
				min-width: 0;
				margin-top: var(--spacing-1);
				opacity: 1;
				visibility: visible;
				transform: none;
				box-shadow: none;
				border: none;
				border-left: 2px solid var(--color-border);
				border-radius: 0;
			}

			.nav-drop.open .nav-menu {
				display: block;
			}

			.nav-contact {
				margin-inline-start: 0;
				margin-top: var(--spacing-2);
				justify-content: center;
			}
		}

		/* Header search was removed by design; the dedicated /search page remains. */

			main {
				min-height: calc(100vh - var(--nav-height) - 300px);
			}

			/* Footer */
			.site-footer {
				background: var(--color-bg-subtle);
				border-top: 1px solid var(--color-border-subtle);
			}

			.footer-inner {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--section-y) var(--page-gutter) var(--spacing-8);
			}

			.footer-grid {
				display: grid;
				grid-template-columns: 1.5fr 1fr 1fr 1fr;
				gap: var(--spacing-8);
				margin-bottom: var(--spacing-12);
			}

			.footer-brand {
				max-width: none;
				padding-right: var(--spacing-8);
			}

			.footer-logo {
				font-size: var(--font-size-lg);
				font-weight: 700;
				color: var(--color-text);
				text-decoration: none;
				letter-spacing: var(--tracking-snug);
			}

			.footer-logo-img {
				height: 24px;
				width: auto;
			}

			.footer-tagline {
				margin-top: var(--spacing-4);
				font-size: var(--font-size-sm);
				color: var(--color-text-secondary);
				line-height: var(--leading-relaxed);
			}

			.footer-description {
				margin-top: var(--spacing-3);
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				line-height: var(--leading-relaxed);
			}

			.footer-col {
				min-width: 0;
			}

			.footer-heading {
				font-family: var(--font-mono);
				font-size: var(--font-size-kicker);
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: var(--tracking-eyebrow);
				color: var(--color-muted);
				margin-bottom: var(--spacing-4);
			}

			.footer-links {
				list-style: none;
			}

			.footer-links li {
				margin-bottom: var(--spacing-2);
			}

			.footer-links a {
				color: var(--color-text-secondary);
				text-decoration: none;
				font-size: var(--font-size-sm);
				transition: color var(--transition-fast);
			}

			.footer-links a:hover {
				color: var(--color-text);
			}

			.footer-bottom {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding-top: var(--spacing-6);
				border-top: 1px solid var(--color-border);
			}

			.footer-copyright {
				font-size: var(--font-size-sm);
				color: var(--color-muted);
			}

			.footer-copyright a {
				color: var(--color-text-secondary);
			}

			/* Theme switcher */
			.theme-switcher {
				display: flex;
				gap: var(--spacing-1);
				padding: var(--spacing-1);
				background: var(--color-surface);
				border-radius: var(--radius);
			}

			.theme-btn {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 32px;
				height: 28px;
				background: transparent;
				border: none;
				color: var(--color-muted);
				border-radius: var(--radius);
				cursor: pointer;
				transition: all var(--transition-fast);
			}

			.theme-btn:hover {
				color: var(--color-text-secondary);
			}

			.theme-btn.active {
				background: var(--color-bg);
				color: var(--color-text);
				box-shadow: var(--shadow-sm);
			}

			.theme-btn svg {
				width: 16px;
				height: 16px;
			}

		@media (max-width: 900px) {
			.footer-grid {
				grid-template-columns: 1fr;
				gap: var(--spacing-6);
			}

			.footer-brand {
				padding-right: 0;
			}
		}

		@media (max-width: 640px) {
			.footer-grid {
				grid-template-columns: 1fr;
			}

				.footer-brand {
					grid-column: span 1;
				}

				.footer-bottom {
					flex-direction: column;
					gap: var(--spacing-4);
					text-align: center;
				}
			}
		</style>

	<script>
		// Header navigation only: mobile toggle, dropdown toggles,
		// dismiss on outside click / Escape.
		(function () {
			var header = document.querySelector(".site-header");
			if (!header) return;
			var toggle = header.querySelector(".nav-toggle");
			var links = header.querySelector("#site-nav-links");
			function closeDrops() {
				header.querySelectorAll(".nav-drop.open").forEach(function (drop) {
					drop.classList.remove("open");
					var btn = drop.querySelector(".nav-top");
					if (btn) btn.setAttribute("aria-expanded", "false");
				});
			}
			if (toggle && links) {
				toggle.addEventListener("click", function () {
					var open = links.classList.toggle("open");
					toggle.setAttribute("aria-expanded", String(open));
					if (!open) closeDrops();
				});
			}
			header.querySelectorAll(".nav-drop > .nav-top").forEach(function (btn) {
				btn.addEventListener("click", function () {
					var drop = btn.parentElement;
					if (!drop) return;
					var wasOpen = drop.classList.contains("open");
					closeDrops();
					if (!wasOpen) {
						drop.classList.add("open");
						btn.setAttribute("aria-expanded", "true");
					}
				});
			});
			document.addEventListener("click", function (e) {
				if (!header.contains(e.target)) {
					closeDrops();
					if (links) links.classList.remove("open");
					if (toggle) toggle.setAttribute("aria-expanded", "false");
				}
			});
			document.addEventListener("keydown", function (e) {
				if (e.key === "Escape") {
					closeDrops();
					if (links) links.classList.remove("open");
					if (toggle) toggle.setAttribute("aria-expanded", "false");
				}
			});
		})();
	</script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
