---
import { getEmDashEntry, getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { getReadingTime } from "../utils/reading-time";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const [settings, { entry: home }, { entries: posts, cacheHint }] =
	await Promise.all([
		getSiteSettings(),
		getEmDashEntry("pages", "home"),
		getEmDashCollection("posts", {
			status: "published",
			orderBy: { published_at: "desc" },
			limit: 6,
		}),
	]);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

/*
 * The homepage is composed from the "home" page entry in the CMS. Its
 * Portable Text blocks are mapped into a structured model here; the
 * academy post list is fetched live from the posts collection.
 */
type ImageRef = { url: string; width?: number; height?: number; alt: string };
type Cta = { label: string; href: string };
type Pillar = {
	image: ImageRef;
	title: string;
	description: string;
	items: string[];
	cta: Cta | null;
};
type Founder = { image: ImageRef; name: string; role: string; bio: string };
type HomeModel = {
	hero: { title: string; subtitle: string; cta: Cta };
	mascot: ImageRef | null;
	system: { title: string; pillars: Pillar[] };
	founders: { title: string; people: Founder[] };
	reviews: { title: string; images: ImageRef[] };
	academy: { title: string; viewAll: string | null };
};

type Block = Record<string, any>;

function blockText(block: Block): string {
	return (block.children ?? [])
		.filter((c: Block) => c._type === "span" && typeof c.text === "string")
		.map((c: Block) => c.text)
		.join("");
}

function blockHref(block: Block): string | null {
	const link = (block.markDefs ?? []).find(
		(md: Block) => md._type === "link" && typeof md.href === "string",
	);
	return link ? link.href : null;
}

function parseHomePage(blocks: Block[]): HomeModel {
	const model: HomeModel = {
		hero: { title: "", subtitle: "", cta: { label: "Book Intro Call", href: "#" } },
		mascot: null,
		system: { title: "", pillars: [] },
		founders: { title: "", people: [] },
		reviews: { title: "", images: [] },
		academy: { title: "", viewAll: null },
	};

	let phase: "hero" | "system" | "founders" | "reviews" | "academy" | "tail" =
		"hero";
	let pillar: Pillar | null = null;
	let person: Founder | null = null;
	const paragraphs: string[] = [];

	const closePillar = () => {
		if (pillar) {
			model.system.pillars.push(pillar);
			pillar = null;
		}
	};
	const closePerson = () => {
		if (person) {
			model.founders.people.push(person);
			person = null;
		}
	};

	for (const b of blocks) {
		if (b._type === "image") {
			const img: ImageRef = {
				url: b.asset?.url ?? "",
				width: b.width,
				height: b.height,
				alt: b.alt ?? "",
			};
			if (phase === "hero") model.mascot = img;
			else if (phase === "system") {
				closePillar();
				pillar = { image: img, title: "", description: "", items: [], cta: null };
			} else if (phase === "founders") {
				closePerson();
				person = { image: img, name: "", role: "", bio: "" };
			} else if (phase === "reviews") model.reviews.images.push(img);
			continue;
		}
		if (b._type !== "block") continue;

		const style = b.style;
		const rawText = blockText(b).trim();
		const text = rawText.replace(/\s+/g, " ").trim();
		const href = blockHref(b);

		if (style === "h1") {
			model.hero.title = text;
			continue;
		}
		if (style === "h2") {
			if (phase === "hero" && !model.hero.subtitle) {
				model.hero.subtitle = text;
				continue;
			}
			closePillar();
			closePerson();
			if (text === "The system behind predictable growth") {
				phase = "system";
				model.system.title = text;
			} else if (text === "About Founders") {
				phase = "founders";
				model.founders.title = text;
			} else if (text.includes("Review")) {
				phase = "reviews";
				model.reviews.title = text;
			} else if (text.includes("Latest from") || text.includes("Academy")) {
				phase = "academy";
				model.academy.title = text;
			} else {
				phase = "tail";
			}
			continue;
		}
		if (style === "normal" && phase === "hero" && href) {
			model.hero.cta = { label: text || model.hero.cta.label, href };
			continue;
		}
		if (phase === "system" && pillar) {
			if (style === "h3") {
				pillar.title = text;
			} else if (style === "normal") {
				if (href) pillar.cta = { label: text, href };
				else if (!pillar.description) pillar.description = text;
				else if (pillar.items.length < 8) pillar.items.push(text);
			}
			continue;
		}
		if (phase === "founders" && person) {
			if (style === "h3") person.name = text;
			else if (style === "h6" && rawText) person.role = rawText;
			else if (style === "normal" && text) paragraphs.push(text);
			continue;
		}
		if (phase === "academy" && style === "h6") {
			model.academy.viewAll = href && href !== "#" ? href : null;
		}
	}
	closePillar();
	closePerson();

	// Assign bio paragraphs to founders in document order.
	model.founders.people.forEach((p, i) => {
		p.bio = paragraphs[i] ?? "";
	});
	return model;
}

const homeModel = parseHomePage(home?.data?.content ?? []);

// "Book Intro Call" in the source content points at "#": wire it to the
// existing scheduling page so the primary CTA is not a dead link.
function resolveCta(cta: Cta | null): Cta {
	if (!cta) return { label: "Book Intro Call", href: "/pages/book-your-free-consultation" };
	const href = cta.href && cta.href !== "#" ? cta.href : "/pages/book-your-free-consultation";
	return { label: cta.label, href };
}

const heroCta = resolveCta(homeModel.hero.cta);
const system = homeModel.system;
const founders = homeModel.founders;
const reviews = homeModel.reviews;
const academy = homeModel.academy;
const mascot = homeModel.mascot;
const foundCtas = resolveCta(null);
---

<Base title={siteTitle} description={siteTagline}>
	<main class="home">
	<!-- 01 · Hero -->
	<header class="hero">
		<div class="hero-inner">
			<div class="hero-copy">
				<span class="hero-eyebrow"><span class="hero-eyebrow-dot" aria-hidden="true"></span>{siteTagline}</span>
				<h1 class="hero-title">Find and Pull Your Biggest Growth Levers with Experimentation</h1>
				<p class="hero-sub">We run your CRO operation, from research and prioritization to implementation and analysis.</p>
				<a class="hero-cta" href={heroCta.href}>
					{heroCta.label}<span aria-hidden="true">→</span>
				</a>
			</div>
			{
				mascot?.url && (
					<figure class="hero-visual">
						<div class="hero-glow" aria-hidden="true"></div>
						<div class="hero-pulse-ring" aria-hidden="true"></div>
						<div class="hero-stage">
							<img
								src={mascot.url}
								width={mascot.width}
								height={mascot.height}
								alt=""
								class="hero-frog"
								fetchpriority="high"
							/>
						</div>
						<div class="hero-shadow" aria-hidden="true"></div>
					</figure>
				)
			}
		</div>
	</header>

		<!-- 02 · The system behind predictable growth -->
		{
			system.pillars.length > 0 && (
			<section class="section system">
				<div class="section-head">
					<span class="eyebrow">01</span>
					<h2 class="section-title system-title">How I Find CRO Breakthroughs Again and Again</h2>
				</div>
					<div class="system-grid">
						{system.pillars.map((pillar, i) => (
							<article class="pillar">
								<div class="pillar-frame">
									<span class="pillar-index">{String(i + 1).padStart(2, "0")}</span>
									{
										pillar.image.url && (
											<img
												src={pillar.image.url}
												width={pillar.image.width}
												height={pillar.image.height}
												alt={pillar.image.alt}
												loading="lazy"
												class="pillar-diagram"
											/>
										)
									}
								</div>
								<h3 class="pillar-title">{pillar.title}</h3>
								<p class="pillar-desc">{pillar.description}</p>
								<ul class="pillar-items">
									{pillar.items.map((item) => (
										<li class="pillar-item">{item}</li>
									))}
								</ul>
								{
									pillar.cta && (
										<a class="pillar-cta" href={resolveCta(pillar.cta).href}>
											{pillar.cta.label}
										</a>
									)
								}
							</article>
						))}
					</div>
				</section>
			)
		}

		<!-- 03 · About Founders -->
		{
			founders.people.length > 0 && (
				<section class="section founders">
					<div class="section-head">
						<span class="eyebrow">02</span>
						<h2 class="section-title">{founders.title}</h2>
					</div>
					<div class="founders-grid">
						{founders.people.map((person) => (
							<article class="founder">
								{
									person.image.url && (
										<figure class="founder-figure">
											<img
												src={person.image.url}
												width={person.image.width}
												height={person.image.height}
												alt={person.name}
												loading="lazy"
												class="founder-portrait"
											/>
										</figure>
									)
								}
								<h3 class="founder-name">{person.name}</h3>
								<p class="founder-role">{person.role}</p>
								<p class="founder-bio">{person.bio}</p>
							</article>
						))}
					</div>
				</section>
			)
		}

		<!-- 04 · How Others Reviewed 99Ways -->
		{
			reviews.images.length > 0 && (
				<section class="section reviews">
					<div class="section-head">
						<span class="eyebrow">03</span>
						<h2 class="section-title">{reviews.title}</h2>
					</div>
					<div class="reviews-grid">
						{reviews.images.map((img, i) => (
							<figure class="review-fig">
								<img
									src={img.url}
									width={img.width}
									height={img.height}
									alt={img.alt || "Client review"}
									loading="lazy"
									class="review-short"
								/>
							</figure>
						))}
					</div>
				</section>
			)
		}

		<!-- 05 · Latest from 99Ways Academy -->
		{
			academy.title && (
				<section class="section academy">
					<div class="section-head">
						<span class="eyebrow">04</span>
						<h2 class="section-title">{academy.title}</h2>
						{
							academy.viewAll && (
								<a class="section-link" href={academy.viewAll}>View all posts</a>
							)
						}
					</div>
					{
						posts.length === 0 ? (
							<p class="home-empty">No posts have been published yet.</p>
						) : (
							<div class="academy-grid">
								{posts.map((post) => (
									<PostCard
										title={post.data.title ?? "Untitled"}
										excerpt={post.data.excerpt}
										featuredImage={post.data.featured_image}
										href={`/posts/${post.id}`}
										date={post.data.publishedAt ?? undefined}
										readingTime={getReadingTime(post.data.content)}
										tags={(post.data.terms?.tag ?? []).map((t) => ({
											slug: t.slug,
											label: t.label,
										}))}
										bylines={post.data.bylines ?? []}
									/>
								))}
							</div>
						)
					}
				</section>
			)
		}
	</main>
</Base>

<script>
	// Hero frog interactivity:
	// - ambient: the frog subtly leans toward the cursor anywhere over the hero;
	// - hover: over the frog itself it lifts, tilts toward the pointer and
	//   catches more light, then eases back to rest on leave.
	(function () {
		var hero = document.querySelector(".hero");
		var visual = hero && hero.querySelector(".hero-visual");
		if (!hero || !visual) return;
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
		var frog = visual.querySelector(".hero-frog");
		if (!frog) return;
		var leanT = { x: 0, y: 0 };
		var leanC = { x: 0, y: 0 };
		var hovT = { tx: 0, ty: 0, rx: 0, ry: 0, lift: 0, b: 1, s: 1 };
		var hovC = { tx: 0, ty: 0, rx: 0, ry: 0, lift: 0, b: 1, s: 1 };
		var raf = 0;
		var heroActive = false;
		function settled(a, b) {
			return Math.abs(a - b) < 0.001;
		}
		function tick() {
			leanC.x += (leanT.x - leanC.x) * 0.08;
			leanC.y += (leanT.y - leanC.y) * 0.08;
			if (settled(leanT.x, leanC.x)) leanC.x = leanT.x;
			if (settled(leanT.y, leanC.y)) leanC.y = leanT.y;
			frog.style.setProperty("--hero-fx", (leanC.x * 16).toFixed(1) + "px");
			frog.style.setProperty("--hero-fy", (leanC.y * 12).toFixed(1) + "px");
			frog.style.setProperty("--hero-rr", (leanC.x * 3).toFixed(2) + "deg");
			var k = 0.12;
			hovC.tx += (hovT.tx - hovC.tx) * k;
			hovC.ty += (hovT.ty - hovC.ty) * k;
			hovC.rx += (hovT.rx - hovC.rx) * k;
			hovC.ry += (hovT.ry - hovC.ry) * k;
			hovC.lift += (hovT.lift - hovC.lift) * k;
			hovC.b += (hovT.b - hovC.b) * k;
			hovC.s += (hovT.s - hovC.s) * k;
			frog.style.setProperty("--hf-tx", hovC.tx.toFixed(1) + "px");
			frog.style.setProperty("--hf-ty", hovC.ty.toFixed(1) + "px");
			frog.style.setProperty("--hf-rx", hovC.rx.toFixed(2) + "deg");
			frog.style.setProperty("--hf-ry", hovC.ry.toFixed(2) + "deg");
			frog.style.setProperty("--hf-lift", hovC.lift.toFixed(3));
			frog.style.setProperty("--hf-b", hovC.b.toFixed(3));
			frog.style.setProperty("--hf-scale", hovC.s.toFixed(3));
			var calm =
				leanC.x === leanT.x &&
				leanC.y === leanT.y &&
				settled(hovT.tx, hovC.tx) &&
				settled(hovT.ty, hovC.ty) &&
				settled(hovT.rx, hovC.rx) &&
				settled(hovT.ry, hovC.ry) &&
				settled(hovT.lift, hovC.lift) &&
				settled(hovT.b, hovC.b) &&
				settled(hovT.s, hovC.s);
			if (!calm) {
				raf = requestAnimationFrame(tick);
			} else {
				raf = 0;
			}
		}
		function kick() {
			if (!raf) raf = requestAnimationFrame(tick);
		}
		hero.addEventListener("pointermove", function (e) {
			var r = hero.getBoundingClientRect();
			leanT.x = (e.clientX - r.left) / r.width - 0.5;
			leanT.y = (e.clientY - r.top) / r.height - 0.5;
			heroActive = true;
			kick();
		});
		hero.addEventListener("pointerleave", function () {
			leanT.x = 0;
			leanT.y = 0;
			heroActive = false;
			kick();
		});
		visual.addEventListener("pointerenter", function () {
			visual.classList.add("hovering");
			hovT.lift = 1;
			hovT.b = 1.06;
			hovT.s = 1.02;
			kick();
		});
		visual.addEventListener("pointermove", function (e) {
			var r = frog.getBoundingClientRect();
			var nx = (e.clientX - (r.left + r.width / 2)) / r.width;
			var ny = (e.clientY - (r.top + r.height / 2)) / r.height;
			nx = Math.max(-0.5, Math.min(0.5, nx));
			ny = Math.max(-0.5, Math.min(0.5, ny));
			hovT.tx = nx * 14;
			hovT.ty = ny * 10;
			hovT.rx = ny * -8;
			hovT.ry = nx * 10;
			kick();
		});
		visual.addEventListener("pointerleave", function () {
			visual.classList.remove("hovering");
			hovT.tx = 0;
			hovT.ty = 0;
			hovT.rx = 0;
			hovT.ry = 0;
			hovT.lift = 0;
			hovT.b = 1;
			hovT.s = 1;
			kick();
		});
	})();
</script>

<style>
	.home {
		overflow: clip;
	}

	/* ---------- Hero (standalone frog, CSS 3D + parallax) ---------- */
	.hero {
		position: relative;
		overflow: clip;
		background:
			radial-gradient(
				52rem 30rem at 82% 28%,
				color-mix(in srgb, var(--color-success) 12%, transparent),
				transparent 65%
			),
			radial-gradient(
				44rem 28rem at 10% 88%,
				color-mix(in srgb, var(--color-brand) 10%, transparent),
				transparent 60%
			),
			var(--color-bg);
	}

	.hero-inner {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		align-items: center;
		gap: clamp(2rem, 5vw, 5rem);
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: clamp(5rem, 11vw, 9.5rem) var(--page-gutter)
			clamp(4.5rem, 8vw, 7.5rem);
		perspective: 1200px;
	}

	.hero-copy {
		position: relative;
		z-index: 2;
	}

	.hero-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		padding: 0.5rem 1rem;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: color-mix(in srgb, var(--color-bg) 70%, transparent);
		font-family: var(--font-mono);
		font-size: var(--font-size-kicker);
		font-weight: 600;
		line-height: 1.4;
		letter-spacing: var(--tracking-eyebrow);
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.hero-eyebrow-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--color-success);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-success) 20%, transparent);
		animation: hero-pulse 2.4s ease-in-out infinite;
	}

	@keyframes hero-pulse {
		0%,
		100% {
			transform: scale(1);
		}
		50% {
			transform: scale(1.25);
		}
	}

	.hero-title {
		margin-top: var(--spacing-6);
		font-family: var(--font-hero);
		font-size: clamp(2rem, 1.25rem + 3vw, 3.5rem);
		font-weight: 600;
		line-height: 1.06;
		letter-spacing: -0.02em;
		text-wrap: balance;
		max-width: 16ch;
	}

	.hero-sub {
		margin-top: var(--spacing-5);
		font-size: clamp(1rem, 0.95rem + 0.3vw, 1.125rem);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		max-width: 44ch;
	}

	.hero-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		margin-top: var(--spacing-6);
		padding: 0.95rem 2rem;
		border-radius: 2px;
		background: var(--color-brand);
		color: var(--color-bg);
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
		box-shadow: 0 18px 40px -18px color-mix(in srgb, var(--color-brand) 55%, transparent);
		transition:
			background var(--transition-base),
			transform var(--transition-base),
			box-shadow var(--transition-base);
	}

	.hero-cta:hover {
		background: var(--color-success);
		color: #fff;
		transform: translateY(-2px);
		box-shadow: 0 24px 48px -18px color-mix(in srgb, var(--color-success) 60%, transparent);
	}

	.hero-cta span {
		transition: transform var(--transition-base);
	}

	.hero-cta:hover span {
		transform: translateX(4px);
	}

	.hero-visual {
		position: relative;
		z-index: 1;
		margin: 0;
		display: grid;
		place-items: center;
		width: 100%;
		max-width: 440px;
		justify-self: end;
		perspective: 900px;
	}

	.hero-glow {
		position: absolute;
		width: 112%;
		aspect-ratio: 1;
		background: radial-gradient(
			closest-side,
			color-mix(in srgb, var(--color-success) 22%, transparent),
			transparent 70%
		);
		filter: blur(30px);
		transition: filter 0.5s ease;
	}

	.hero-visual.hovering .hero-glow {
		filter: blur(30px) brightness(1.18);
	}

	.hero-pulse-ring {
		position: absolute;
		bottom: 5%;
		width: 46%;
		height: 30px;
		border: 1px solid color-mix(in srgb, var(--color-success) 45%, transparent);
		border-radius: 50%;
		opacity: 0;
		animation: hero-ring 6s ease-out infinite;
	}

	@keyframes hero-ring {
		0% {
			transform: scale(0.55);
			opacity: 0;
		}
		18% {
			opacity: 0.55;
		}
		60% {
			transform: scale(1.18);
			opacity: 0;
		}
		100% {
			transform: scale(1.18);
			opacity: 0;
		}
	}

	.hero-stage {
		animation:
			hero-enter 1.1s cubic-bezier(0.22, 0.9, 0.28, 1) both,
			hero-breathe 7s ease-in-out 1.1s infinite;
	}

	@keyframes hero-enter {
		from {
			opacity: 0;
			transform: translateY(26px) scale(0.94);
		}
		to {
